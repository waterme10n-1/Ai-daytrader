# Papirhandel (https://paper-api.alpaca.markets)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Live-handel (https://api.alpaca.markets). Skal være udfyldt før live kan låses op.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# true først når du bevidst vil tillade rigtige penge. Standarden er false.
ALLOW_LIVE=false
# Live-størrelse bruger aldrig mere end dette beløb, også hvis kontoen er større.
LIVE_MAX_CAPITAL=1000

# Tom nøgle = kun regelbaseret analyse (ingen Claude).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_WEB_SEARCH_TOOL=web_search_20260209
ANTHROPIC_EFFORT=high
ANTHROPIC_MAX_SEARCH_USES=5
# "default" slår Anthropics server-side fallback til ved afvisning.
ANTHROPIC_FALLBACKS=default

# Valgfrit. Begge skal være sat, ellers sendes der ingen beskeder.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SQLite-fil. Lokalt: trader.db. På Railway: /data/trader.db (volume monteret på /data).
DB_PATH=trader.db

# Lytter. Lokalt 127.0.0.1. På Railway skal HOST være 0.0.0.0, og Railway sætter PORT.
HOST=127.0.0.1
PORT=8741

# Login. Tomt på loopback = intet login. På 0.0.0.0 skal alle tre være sat, ellers starter serveren ikke.
# Brug enten APP_PASSWORD eller APP_PASSWORD_HASH (pbkdf2). Hashen vinder, hvis begge er sat.
APP_USERNAME=
APP_PASSWORD=
APP_PASSWORD_HASH=
# Mindst 32 tegn. python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
