# Valgfri. Med nøglen researcher Claude hver kandidat på X og nyheder. Betales separat fra Claude Max.
ANTHROPIC_API_KEY=
# "default" slår Anthropics server-side fallback til ved afvisning.
ANTHROPIC_FALLBACKS=default

# Valgfrit. Begge skal være sat, ellers sendes der ingen beskeder.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SQLite-fil. Lokalt: trader.db. På Railway: /data/trader.db (volume monteret på /data).
DB_PATH=trader.db

# Lytter. Lokalt 127.0.0.1. På Railway skal HOST være 0.0.0.0, og Railway sætter PORT.
HOST=127.0.0.1
PORT=8741

# To-trins-login (anbefales før rigtige penge). Lav hemmeligheden med: python -m trader.auth totp
# Når den er sat, kræver login, udbetaling og "rigtige penge" en kode fra din godkendelses-app.
APP_TOTP_SECRET=

# Login. Tomt på loopback = intet login. På 0.0.0.0 skal alle tre være sat, ellers starter serveren ikke.
# Brug enten APP_PASSWORD eller APP_PASSWORD_HASH (pbkdf2). Hashen vinder, hvis begge er sat.
APP_USERNAME=
APP_PASSWORD=
APP_PASSWORD_HASH=
# Mindst 32 tegn. python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# ---------------------------------------------------------------- Memebot (Solana)
# Kører altid på papirpenge med rigtige kurser, indtil kravene på /meme er opfyldt.
MEME_ENABLED=true
# Startbeløb og hårdt loft. Botten bruger aldrig mere end dette i alt, heller ikke hvis wallet'en er større.
# På papir kan du starte forfra med et andet beløb under Mere → Indstillinger → Papirkonto (beløbene pr. handel skaleres med).
MEME_BANKROLL_USD=15
MEME_POSITION_USD=3
MEME_MAX_OPEN=3
MEME_MAX_TRADES_PER_DAY=8
# Andel af bankroll: dagligt tab stopper nye køb til næste dag; samlet tab sælger alt og stopper botten.
# Ingen daglig tabsgrænse som standard; den samlede tabsgrænse er slået til. Begge kan ændres her
# eller under Mere → Indstillinger → Tabsgrænser. Botten bruger aldrig mere end MEME_BANKROLL_USD.
MEME_DAILY_LOSS_LIMIT=false
MEME_DRAWDOWN_LIMIT=true
# Strategi-vagt (til som standard): sæt en tabende strategi på hold. Automatisk mål: sniperen og den almindelige strategi lærer selv mål og stop.
MEME_STRATEGY_GUARD=true
MEME_AUTO_TARGETS=true
MEME_DAILY_LOSS_PCT=0.25
MEME_MAX_DRAWDOWN_PCT=0.5

# Kun til rigtige penge. Brug en NY, separat Phantom-konto med kun det beløb, botten må tabe.
# Phantom: Indstillinger -> Administrer konti -> (den nye konto) -> Vis privat nøgle.
# Indsæt den KUN som hemmelig variabel hos din hosting (fx Railway). Aldrig i chat, aldrig i git.
MEME_ALLOW_LIVE=false
SOLANA_PRIVATE_KEY=
# Din hovedkonto i Phantom. Udbetalinger fra botten går KUN hertil, også de automatiske.
# Tip: Forbind Phantom på /meme under fanen Wallet, så vises adressen med en kopiér-knap.
MEME_WITHDRAW_ADDRESS=
# 0 = fra. Fx 5: når bot-wallet'en har mere end bankroll + 5 USD i fri SOL, sendes overskuddet
# til MEME_WITHDRAW_ADDRESS (højst hver halve time, kun når botten handler live).
MEME_SWEEP_ABOVE_USD=0
# Gratis nøgle fra helius.dev anbefales. Den offentlige RPC er langsom og rate-limited.
SOLANA_RPC_URL=
MEME_SOL_RESERVE=0.02
MEME_SLIPPAGE_BPS=300
MEME_PRIORITY_FEE_LAMPORTS=100000

# Sniper: køber helt nye tokens, der består rug-tjek, og sælger ved dit gevinstmål.
# Mål, stop-loss, beløb og filtre ændres på /meme under fanen Sniper.
MEME_SNIPER_ENABLED=true
# Startbeløb pr. snipe. Kan aldrig overstige MEME_POSITION_USD.
MEME_SNIPER_POSITION_USD=1.5
MEME_SNIPER_MAX_OPEN=2
MEME_SNIPER_MAX_PER_DAY=10
MEME_SNIPER_SCAN_SECONDS=10

# Valgfrit. Wallets der følges (kommasepareret). Deres køb er kun et signal, ikke en ordre.
MEME_COPY_WALLETS=

# Valgfrit. X API (betalt hos X). Uden den tjekkes X kun gennem Claudes websøgning.
X_BEARER_TOKEN=
X_DAILY_REQUESTS=40

# Claude-research af X/nyheder og daglig gennemgang af fejl. Bruger ANTHROPIC_API_KEY ovenfor.
# API-forbrug betales separat fra et Claude Max-abonnement. Hvert tjek koster ca. 0,15-0,40 USD.
# Intet dagligt loft som standard. true = Claude stopper for i dag ved MEME_AI_DAILY_BUDGET_USD.
# Kan også slås til og fra under Mere → Indstillinger → Tabsgrænser. 0 i budgettet slår Claude helt fra.
MEME_AI_BUDGET_LIMIT=false
MEME_AI_DAILY_BUDGET_USD=0.5
MEME_ANTHROPIC_MODEL=claude-opus-5-5
MEME_ANTHROPIC_EFFORT=medium
MEME_ANTHROPIC_MAX_SEARCH_USES=4

# Anbefalet. Gratis nøgle fra portal.jup.ag. Uden nøgle tillader Jupiter ca. 30 kald/min, og grænsen deles
# med andre servere på samme IP (fx hos Railway), så du kan se "rate limit (429)". Med nøgle: 60/min pr. konto,
# og api.jup.ag bruges automatisk. JUPITER_API_URL skal kun sættes, hvis du vil bruge en anden adresse.
JUPITER_API_KEY=
JUPITER_API_URL=
# Botten holder sig selv under grænsen: 25 kald/min uden nøgle, 55 med. Salg går altid forrest.
# Sæt kun JUPITER_RPM, hvis du har en betalt plan med højere grænse.
JUPITER_RPM=

# Følg top-traders (slås til og fra under Strategi → Top 10). Med en nøgle fra solanatracker.io henter botten
# selv dagens mest profitable Solana-traders hver halve time. Uden nøgle bruges dine fulgte wallets i stedet.
SOLANATRACKER_API_KEY=
# true = slået til fra start. Standard er fra; tænd hellere i dashboardet.
MEME_TOPTRADERS=false

# RugCheck oplyser ingen fast grænse. Botten bruger højst 30 kald/min og holder pause ved 429.
# Uden rug-tjek købes der intet, så et token, der rammer grænsen, tjekkes igen i næste runde i stedet for at blive afvist.
# RUGCHECK_API_KEY er valgfri (sendes som X-API-KEY), hvis du har en nøgle fra rugcheck.xyz.
RUGCHECK_API_KEY=
RUGCHECK_RPM=

# Link til Axiom fra hvert token. {pair} er handelsparrets adresse, {mint} er tokenets.
# Åbner linket forkert, så prøv https://axiom.trade/t/{mint}
MEME_AXIOM_LINK=https://axiom.trade/meme/{pair}

# Papirhandel tæt på virkeligheden: andel fejlede handler og ekstra slippage i procent.
MEME_PAPER_FAIL_RATE=0.05
MEME_PAPER_SLIPPAGE_PCT=1
MEME_PAPER_SNIPER_EXTRA_PCT=2

# Udførelse: rpc (standard) eller jito (tip til Jito, lander oftere og ses ikke i den offentlige strøm).
MEME_EXECUTION=rpc
MEME_JITO_TIP_LAMPORTS=100000

# Sælg med det samme, hvis udvikleren eller topholderne sælger ud.
MEME_DEV_WATCH=true
# Følg afviste tokens i 6 timer og lær af dem (skyggehandler og målberegneren).
MEME_SHADOWS=true

# Telegram-kommandoer (/status, /pause, /saelg …) og dagsrapport. Bruger TELEGRAM_BOT_TOKEN og TELEGRAM_CHAT_ID.
MEME_TELEGRAM_COMMANDS=true
# Time i UTC for dagsrapporten. 19 = kl. 20 dansk vintertid. -1 = ingen rapport.
MEME_REPORT_HOUR_UTC=19

# Faste udgifter pr. måned, så målet viser det ærlige tal (Railway, X API, RPC …).
MEME_HOSTING_USD_PER_MONTH=5
MEME_OTHER_COSTS_USD_PER_MONTH=0

# Målet i dashboardet (Claude Max 5x = 100, 20x = 200 USD pr. måned).
MEME_GOAL_USD_PER_MONTH=100
# Tom = meme.db ved siden af DB_PATH (på Railway: /data/meme.db).
MEME_DB_PATH=

# ---------------------------------------------------------------- Handelsbordet (/desk)
# Seks bots i én gruppechat: SCOUT, NEWS, CHART, SKEPTIC, SIZER og EXECUTOR. Kun papirpenge, og intet køb uden din godkendelse.
DESK_ENABLED=true
# Papirnøgler fra app.alpaca.markets (Paper). Tom = ALPACA_API_KEY og ALPACA_SECRET_KEY, hvis de er sat.
DESK_ALPACA_API_KEY=
DESK_ALPACA_SECRET_KEY=
# 10-20 tickers du kender. SMCI, MSTR, SOFI og RIVN er med, fordi de oftere flytter sig. Kan også ændres på /desk under Bots.
DESK_WATCHLIST=NVDA,AAPL,MSFT,AMZN,META,GOOGL,TSLA,AMD,AVGO,NFLX,PLTR,COIN,SMCI,MSTR,SOFI,RIVN
# SCOUT: bevægelse på en time i %, volumen i gange normal, højst markeringer pr. dag.
# Kvoten gælder markeringer på kursbevægelse. Dem kun på volumen har deres egen kvote af samme størrelse.
DESK_MOVE_PCT=1.5
DESK_VOLUME_X=2
DESK_MAX_FLAGS_PER_DAY=8
# Før åbning (4:00-9:30 ET, 10:00-15:30 dansk tid): SCOUT finder aktier, der er steget DESK_GAP_PCT siden i går,
# og NEWS finder grunden. Fra 9:45 til 11:00 ET kan et gap, der holder sig over VWAP, blive markeret og købt.
DESK_PREMARKET=true
DESK_GAP_PCT=3
# CHART: stop højst x% under indgangen, målet mindst x gange så langt væk.
DESK_STOP_MAX_PCT=2
DESK_REWARD_RISK=2
# SIZER: højst x% af kontoen pr. handel (hårdt loft 10) og højst x åbne (hårdt loft 5).
DESK_POSITION_PCT=5
DESK_MAX_OPEN=3
DESK_DAILY_LOSS_PCT=2
# EXECUTOR: så mange minutter har du til at godkende. Kursen må højst være løbet x% over indgangen.
DESK_APPROVAL_MINUTES=10
DESK_MAX_CHASE_PCT=0.5
# SCOUT kigger hvert x minut (1 = hvert minut).
DESK_SCAN_MINUTES=1
# Autopilot: true = bordet køber selv på papir, når SKEPTIC siger BUY. false = du godkender hver ordre.
DESK_AUTO_APPROVE=true
# Prøvekøb: siger SKEPTIC WAIT, eller finder NEWS ingen grund, til en kursbevægelse med en ren opstilling, købes halv
# størrelse alligevel (aldrig kun på volumen, aldrig mod en lært regel). false = WAIT og SKIP betyder altid nej.
DESK_TRIAL_BUYS=true
# Claude til NEWS, SKEPTIC og dine @-spørgsmål. Bruger ANTHROPIC_API_KEY.
# 0 = intet dagligt loft (standard). Sæt fx 2 for at stoppe Claude ved 2 USD om dagen; så tager faste regler over.
DESK_AI_DAILY_BUDGET_USD=0
# Model til bordet. Standard er den billige claude-haiku-5-5 (Memebot har sin egen: MEME_ANTHROPIC_MODEL).
DESK_ANTHROPIC_MODEL=claude-haiku-5-5
DESK_ANTHROPIC_EFFORT=high
DESK_MAX_CHAT_PER_DAY=40
# Tom = desk.db ved siden af DB_PATH (på Railway: /data/desk.db).
DESK_DB_PATH=

# ---------------------------------------------------------------- Handelsbordet: Københavns børs
# Samme seks bots på danske aktier (9:00-17:00). Bordets egen papirkonto i kroner, kurser fra Yahoo Finance.
DESK_DK_ENABLED=true
DESK_DK_WATCHLIST=NOVO-B,DSV,DANSKE,ORSTED,VWS,GMAB,PNDORA,CARL-B,COLO-B,NSIS-B,DEMANT,GN,NKT,BAVA,ZEAL,AMBU-B
# SCOUT i København: bevægelse på en time i %. Lavere end i New York, fordi store danske aktier flytter sig mindre.
DESK_DK_MOVE_PCT=1.5
# SCOUT i København kigger hvert x minut. Yahoo siger 429, hvis bordet spørger for tit, så standarden er 5.
DESK_DK_SCAN_MINUTES=5
# Papirkontoens startbeløb i kroner og kurtage i % pr. handel (trækkes fra i købs- og salgskursen).
DESK_DK_START_CASH=100000
DESK_DK_FEE_PCT=0.1
# Tom = desk_dk.db ved siden af desk.db (på Railway: /data/desk_dk.db).
DESK_DK_DB_PATH=
